---
import { pwaInfo } from 'virtual:pwa-info'
import '@fontsource/source-serif-4/latin-600.css'
import '@fontsource/source-sans-3/latin-400.css'
import '@fontsource/source-sans-3/latin-500.css'
import '@fontsource/source-sans-3/latin-600.css'
import '../styles/global.css'
import { profile } from '../data/site'

interface Props {
  title?: string
  description?: string
  /** Pathname for the canonical URL, e.g. `/` or `/projects` */
  pathname?: string
  ogImagePath?: string
  ogImageAlt?: string
  ogImageWidth?: number
  ogImageHeight?: number
  jsonLd?: Record<string, unknown> | Record<string, unknown>[]
  /** Preload the hero AVIF set (homepage only) */
  preloadHero?: boolean
  /** Set false when the page draws its own skip control. Defaults to the homepage skip link. */
  showSkip?: boolean
}

const {
  title = 'Maysen Greenwood — Software developer',
  description = profile.description,
  pathname = Astro.url.pathname,
  ogImagePath = '/assets/images/hero-image-1280.webp',
  ogImageAlt = 'Star-filled night sky, the header photograph on this site',
  ogImageWidth = 1280,
  ogImageHeight = 720,
  jsonLd,
  preloadHero = false,
  showSkip = true,
} = Astro.props

const site = Astro.site ?? new URL('https://maysengreenwood.com')
const normalizedPath = pathname === '/' ? '/' : pathname.replace(/\/$/, '')
const canonical = new URL(normalizedPath, site)
const ogImage = new URL(ogImagePath, site)
const heroPreload = [640, 960, 1280, 1600]
  .map((width) => `/assets/images/hero-image-${width}.avif ${width}w`)
  .join(', ')

const defaultJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  dateModified: '2026-11-15',
  mainEntity: {
    '@type': 'Person',
    name: profile.name,
    url: new URL('/', site).href,
    jobTitle: 'Software developer',
    email: `mailto:${profile.email}`,
    address: {
      '@type': 'PostalAddress',
      addressCountry: 'NZ',
    },
    worksFor: {
      '@type': 'Organization',
      name: 'Henry Schein One',
    },
    sameAs: [profile.github, profile.linkedin],
    knowsAbout: ['Ruby on Rails', 'Ember', 'ASP.NET', 'React', 'TypeScript'],
  },
}

const structuredData = jsonLd ?? defaultJsonLd
const structuredDataBlocks = Array.isArray(structuredData) ? structuredData : [structuredData]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#16141c" />
    <link rel="canonical" href={canonical.href} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content="en_NZ" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {
      preloadHero && (
        <link
          rel="preload"
          as="image"
          href="/assets/images/hero-image-1280.avif"
          imagesrcset={heroPreload}
          imagesizes="100vw"
          type="image/avif"
          fetchpriority="high"
        />
      )
    }

    {
      structuredDataBlocks.map((block) => (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(block).replace(/</g, '\\u003c')}
        />
      ))
    }

    {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
  </head>
  <body>
    {showSkip && <a class="skip-link" href="#main">Skip to content</a>}
    <slot />
    <script>
      import { registerSW } from 'virtual:pwa-register'
      registerSW({ immediate: true })
    </script>
    <script
      type="module"
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "b934bb0421c247709fbc6e5954a704db"}'
      defer></script>
  </body>
</html>
