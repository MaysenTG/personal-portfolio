---
import { emailJs } from '../data/site'
---

<section class="section" id="contact-me">
  <div class="container">
    <div class="contact__grid">
      <div>
        <h2 class="section-title">Contact</h2>
        <p class="section-lead contact__info">
          If you want to talk about a role, a bug, or a ride, email is the most reliable way to
          reach me.
        </p>
        <p class="contact__info">
          <a href="mailto:greenwood.maysen@gmail.com">greenwood.maysen@gmail.com</a>
        </p>
      </div>
      <div>
        <div class="contact__form-card" id="contact-card">
          <form id="contact-form" novalidate>
            <div class="form-field">
              <label class="form-label" for="name">Name</label>
              <input
                type="text"
                id="name"
                class="form-control"
                name="user_name"
                autocomplete="name"
                required
              />
            </div>
            <div class="form-field">
              <label class="form-label" for="email">Email</label>
              <input
                type="email"
                id="email"
                class="form-control"
                name="email"
                autocomplete="email"
                required
              />
            </div>
            <div class="form-field form-field--last">
              <label class="form-label" for="message">Message</label>
              <textarea id="message" rows="5" class="form-control" name="message" required
              ></textarea>
            </div>
            <p class="contact__status contact__status--error" id="contact-error" hidden>
              That didn’t send. Try again, or just use the email on the left.
            </p>
            <button type="submit" class="btn btn-primary btn-block" id="contact-submit" disabled>
              Send message
            </button>
          </form>
          <p class="contact__status" id="contact-success" hidden>
            Got it. I’ll reply when I can.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ emailJs }}>
  const form = /** @type {HTMLFormElement} */ (document.getElementById('contact-form'))
  const submitBtn = /** @type {HTMLButtonElement} */ (document.getElementById('contact-submit'))
  const errorEl = /** @type {HTMLElement} */ (document.getElementById('contact-error'))
  const successEl = /** @type {HTMLElement} */ (document.getElementById('contact-success'))
  const nameInput = /** @type {HTMLInputElement} */ (document.getElementById('name'))
  const emailInput = /** @type {HTMLInputElement} */ (document.getElementById('email'))
  const messageInput = /** @type {HTMLTextAreaElement} */ (document.getElementById('message'))

  const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/
  let sending = false

  function isValid() {
    return (
      emailRegex.test(emailInput.value.trim()) &&
      nameInput.value.trim() &&
      messageInput.value.trim()
    )
  }

  function syncButton() {
    submitBtn.disabled = !isValid() || sending
    submitBtn.textContent = sending ? 'Sending…' : 'Send message'
  }

  ;[nameInput, emailInput, messageInput].forEach((el) => {
    el.addEventListener('input', syncButton)
  })

  form.addEventListener('submit', async (event) => {
    event.preventDefault()
    if (!isValid() || sending) return

    sending = true
    errorEl.hidden = true
    syncButton()

    try {
      const response = await fetch('https://api.emailjs.com/api/v1.0/email/send', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          service_id: emailJs.service_id,
          template_id: emailJs.template_id,
          user_id: emailJs.user_id,
          template_params: {
            name: nameInput.value,
            email: emailInput.value,
            message: messageInput.value,
          },
        }),
      })

      if (!response.ok) throw new Error(`EmailJS ${response.status}`)

      form.hidden = true
      successEl.hidden = false
    } catch (err) {
      console.error(err)
      errorEl.hidden = false
    } finally {
      sending = false
      syncButton()
    }
  })
</script>
