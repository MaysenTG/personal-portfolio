---
import { emailJs, profile } from '../data/site'
---

<section class="section" id="contact-me">
  <div class="container">
    <div class="contact__grid">
      <div>
        <h2 class="section-title">Contact</h2>
        <p class="section-lead">
          If you want to talk about a role, a bug, or a ride, email is the most reliable way to reach
          me.
        </p>
        <p class="contact__info">
          <a class="contact__email" href={`mailto:${profile.email}`}>{profile.email}</a>
        </p>
      </div>
      <div>
        <div class="contact__form-card" id="contact-card">
          <form id="contact-form" novalidate>
            <div class="form-field">
              <label class="form-label" for="name">Name</label>
              <input
                type="text"
                id="name"
                class="form-control"
                name="user_name"
                autocomplete="name"
                required
              />
            </div>
            <div class="form-field">
              <label class="form-label" for="email">Email</label>
              <input
                type="email"
                id="email"
                class="form-control"
                name="email"
                autocomplete="email"
                inputmode="email"
                required
              />
            </div>
            <div class="form-field form-field--last">
              <label class="form-label" for="message">Message</label>
              <textarea
                id="message"
                rows="5"
                class="form-control"
                name="message"
                enterkeyhint="send"
                required></textarea>
            </div>
            <p class="contact__status contact__status--error" id="contact-error" role="alert" hidden>
              Name, email, and a message.
            </p>
            <button type="submit" class="btn btn-primary btn-block" id="contact-submit">
              Send message
            </button>
          </form>
          <p class="contact__status" id="contact-success" role="status" hidden>
            Got it. I’ll reply when I can.
          </p>
          <noscript>
            <p class="contact__noscript">The form needs JavaScript. You can just email me.</p>
          </noscript>
        </div>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ emailJs }}>
  const form = /** @type {HTMLFormElement} */ (document.getElementById('contact-form'))
  const submitBtn = /** @type {HTMLButtonElement} */ (document.getElementById('contact-submit'))
  const errorEl = /** @type {HTMLElement} */ (document.getElementById('contact-error'))
  const successEl = /** @type {HTMLElement} */ (document.getElementById('contact-success'))
  const nameInput = /** @type {HTMLInputElement} */ (document.getElementById('name'))
  const emailInput = /** @type {HTMLInputElement} */ (document.getElementById('email'))
  const messageInput = /** @type {HTMLTextAreaElement} */ (document.getElementById('message'))

  const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/
  const validationMessage = 'Name, email, and a message.'
  const sendFailureMessage = 'That didn’t send. Try again, or just email me.'
  let sending = false

  /** @returns {HTMLInputElement | HTMLTextAreaElement | null} */
  function firstInvalid() {
    if (!nameInput.value.trim()) return nameInput
    if (!emailRegex.test(emailInput.value.trim())) return emailInput
    if (!messageInput.value.trim()) return messageInput
    return null
  }

  function showError(message) {
    errorEl.textContent = message
    errorEl.hidden = false
  }

  form.addEventListener('submit', async (event) => {
    event.preventDefault()
    if (sending) return

    const invalid = firstInvalid()
    if (invalid) {
      showError(validationMessage)
      invalid.focus()
      return
    }

    sending = true
    errorEl.hidden = true
    submitBtn.disabled = true
    submitBtn.textContent = 'Sending…'

    try {
      const response = await fetch('https://api.emailjs.com/api/v1.0/email/send', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          service_id: emailJs.service_id,
          template_id: emailJs.template_id,
          user_id: emailJs.user_id,
          template_params: {
            name: nameInput.value,
            email: emailInput.value,
            message: messageInput.value,
          },
        }),
      })

      if (!response.ok) throw new Error(`EmailJS ${response.status}`)

      form.hidden = true
      successEl.hidden = false
    } catch (err) {
      console.error(err)
      showError(sendFailureMessage)
    } finally {
      sending = false
      submitBtn.disabled = false
      submitBtn.textContent = 'Send message'
    }
  })
</script>
