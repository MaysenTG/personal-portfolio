---
import { aboutCopy } from '../data/site'
---

<section class="section section--light" id="about">
  <div class="container">
    <h2 class="section-title">About</h2>
    <div class="about">
      <p class="about__statement">{aboutCopy.statement}</p>
      <div class="about__copy">
        <p class="about__text">{aboutCopy.body}</p>
      </div>
    </div>
    <dl class="about__facts">
      {
        aboutCopy.facts.map((fact) => (
          <div>
            <dt>{fact.label}</dt>
            <dd>{fact.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
