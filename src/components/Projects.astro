---
import { getHomepageProjects } from '../data/projects'
import ProjectCard from './ProjectCard.astro'

const homeProjects = getHomepageProjects()
---

<section class="section" id="projects">
  <div class="container">
    <div class="section-intro">
      <h2 class="section-title">Projects</h2>
      <p class="section-lead">
        A selection of my projects, including my newest, Who Funds NZ. The full list is on the
        projects page.
      </p>
    </div>
    <ul class="project__list">
      {homeProjects.map((project) => <ProjectCard project={project} />)}
    </ul>
    <p class="projects-more">
      <a class="projects-more__link" href="/projects">View all projects</a>
    </p>
  </div>
</section>
