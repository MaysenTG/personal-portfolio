---
import ResponsivePicture from './ResponsivePicture.astro'
import { heroImageWidths } from '../data/projects'
---

<section class="hero">
  <ResponsivePicture
    name="hero-image"
    widths={[...heroImageWidths]}
    sizes="100vw"
    width={1600}
    height={900}
    alt=""
    class="hero__media"
    loading="eager"
    fetchpriority="high"
  />
  <div class="container">
    <div class="hero__content">
      <p class="hero__greeting">Hey, I’m Maysen.</p>
      <h1 class="hero__title">I write software for the web.</h1>
      <p class="hero__tagline">
        I work as an intermediate developer at Henry Schein One. I spend most of my time in Ruby
        on Rails and Ember, but I enjoy building with .NET and React.
      </p>
      <div class="hero__actions">
        <a class="btn btn-primary" href="#projects">See the work</a>
        <a class="btn btn-outline-light" href="#contact-me">Say hello</a>
      </div>
    </div>
  </div>
</section>
