---
interface Props {
  name: string
  widths: number[]
  sizes: string
  width: number
  height: number
  alt?: string
  class?: string
  loading?: 'lazy' | 'eager'
  fetchpriority?: 'high' | 'low' | 'auto'
}

const {
  name,
  widths,
  sizes,
  width,
  height,
  alt = '',
  class: className,
  loading = 'lazy',
  fetchpriority,
} = Astro.props

const sorted = [...widths].sort((a, b) => a - b)
const largest = sorted.at(-1)!
const avifSrcset = sorted.map((w) => `/assets/images/${name}-${w}.avif ${w}w`).join(', ')
const webpSrcset = sorted.map((w) => `/assets/images/${name}-${w}.webp ${w}w`).join(', ')
---

<picture>
  <source type="image/avif" srcset={avifSrcset} sizes={sizes} />
  <source type="image/webp" srcset={webpSrcset} sizes={sizes} />
  <img
    src={`/assets/images/${name}-${largest}.webp`}
    srcset={webpSrcset}
    sizes={sizes}
    width={width}
    height={height}
    alt={alt}
    class={className}
    loading={loading}
    decoding="async"
    fetchpriority={fetchpriority}
  />
</picture>
