---
import ResponsivePicture from './ResponsivePicture.astro'
import type { Project } from '../data/projects'
import { projectImageWidths } from '../data/projects'

interface Props {
  project: Project
}

const { project } = Astro.props
const featuredClass = project.featured ? 'project--featured' : ''
const primaryHref = project.live_url || project.github_repo
---

<li class={`project ${featuredClass}`}>
  <article class="project__card">
    <div
      class="project__image-wrapper"
      style={project.imagePosition ? `--project-image-position: ${project.imagePosition}` : undefined}
    >
      <ResponsivePicture
        name={project.image}
        widths={[...projectImageWidths]}
        sizes={
          project.featured
            ? '(min-width: 900px) 55vw, 100vw'
            : '(min-width: 900px) 33vw, (min-width: 600px) 50vw, 100vw'
        }
        width={project.imageWidth}
        height={project.imageHeight}
        alt={project.alt}
        class="project__img"
        loading={project.featured ? 'eager' : 'lazy'}
      />
    </div>
    <div class="project__content">
      <div class="project__content-main">
        <h3 class="project__title">
          <a href={primaryHref} rel="noopener noreferrer" target="_blank">{project.title}</a>
        </h3>
        <ul class="project__skills-list">
          {project.skills.map((skill) => <li class="project__skill-tag">{skill}</li>)}
        </ul>
        <p class="project__description">{project.description}</p>
      </div>
      <div class="project__links">
        {
          project.github_repo && (
            <a
              href={project.github_repo}
              rel="noopener noreferrer"
              target="_blank"
              class="project__link"
            >
              <svg class="project__link-icon" viewBox="0 0 16 16" aria-hidden="true">
                <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8" />
              </svg>
              GitHub
              <span class="visually-hidden">: {project.title}</span>
            </a>
          )
        }
        {
          project.live_url && (
            <a
              href={project.live_url}
              rel="noopener noreferrer"
              target="_blank"
              class="project__link"
            >
              <svg class="project__link-icon" viewBox="0 0 16 16" aria-hidden="true">
                <path d="M8.6 1.5h6v6h-1.5V4.06L7.53 9.64 6.47 8.58l5.57-5.58H8.6V1.5zM3 3h4.25v1.5H4.5v7h7V8.75H13V13H3V3z" />
              </svg>
              Live
              <span class="visually-hidden"> site: {project.title}</span>
            </a>
          )
        }
      </div>
    </div>
  </article>
</li>
