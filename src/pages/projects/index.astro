---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Navbar from '../../components/Navbar.astro'
import Footer from '../../components/Footer.astro'
import ProjectCard from '../../components/ProjectCard.astro'
import { projects, resolveProjectImage } from '../../data/projects'
import { profile } from '../../data/site'

const title = 'Projects — Maysen Greenwood'
const description =
  'Projects by Maysen Greenwood, including Who Funds NZ, CronClock, PasteTable, and ZWO Builder, with live demos and code on GitHub.'
const pathname = '/projects'
const site = Astro.site ?? new URL('https://maysengreenwood.com')
const pageUrl = new URL(pathname, site).href
const homeUrl = new URL('/', site).href

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Projects',
    description,
    url: pageUrl,
    isPartOf: {
      '@type': 'WebSite',
      name: profile.name,
      url: homeUrl,
    },
    about: {
      '@type': 'Person',
      name: profile.name,
      url: homeUrl,
    },
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: projects.length,
      itemListElement: projects.map((project, index) => {
        const image = resolveProjectImage(project)
        const url = project.live_url || project.github_repo
        return {
          '@type': 'ListItem',
          position: index + 1,
          item: {
            '@type': 'CreativeWork',
            name: project.title,
            description: project.description,
            url,
            image: new URL(`/assets/images/${image.image}-1200.webp`, site).href,
            author: {
              '@type': 'Person',
              name: profile.name,
              url: homeUrl,
            },
            ...(project.github_repo ? { sameAs: project.github_repo } : {}),
          },
        }
      }),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: homeUrl,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Projects',
        item: pageUrl,
      },
    ],
  },
]
---

<BaseLayout
  title={title}
  description={description}
  pathname={pathname}
  jsonLd={jsonLd}
  ogImagePath="/assets/images/zwift-workout-builder-1200.webp"
  ogImageAlt="ZWO Builder editing a sweet spot workout, with the power profile in the centre"
  ogImageWidth={1200}
  ogImageHeight={547}
>
  <Navbar />
  <main id="main" class="page-main">
    <section class="section projects-page" id="projects" aria-labelledby="projects-heading">
      <div class="container">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <ol class="breadcrumbs__list">
            <li class="breadcrumbs__item">
              <a href="/">Home</a>
            </li>
            <li class="breadcrumbs__item" aria-current="page">Projects</li>
          </ol>
        </nav>

        <div class="section-intro">
          <h1 class="section-title" id="projects-heading">Projects</h1>
          <p class="section-lead">
            All my recent projects, with the largest first and a link to the code on GitHub for each
            one.
          </p>
        </div>

        <ul class="project__list">
          {projects.map((project) => <ProjectCard project={project} headingLevel="h2" />)}
        </ul>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
