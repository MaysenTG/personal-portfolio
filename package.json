{
  "name": "maysen-portfolio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Personal portfolio for Maysen Greenwood — Astro static site with aggressive client caching",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
