<section class="section" id="contact-me">
  <div class="container">
    <div class="row g-5 align-items-start">
      <div class="col-lg-5">
        <h2 class="section-title">Contact</h2>
        <p class="section-lead contact__info">
          If you want to get in touch, email is the best way to reach me.
        </p>
        <p class="contact__info">
          <a href="mailto:greenwood.maysen@gmail.com">greenwood.maysen@gmail.com</a>
        </p>
      </div>
      <div class="col-lg-7">
        <div class="contact__form-card">
          <form id="contact-form">
            <div class="mb-3">
              <Input
                @type="text"
                @value={{this.name}}
                data-display-name="name"
                data-test-input="name"
                id="name"
                class="form-control"
                name="user_name"
                placeholder="Your name"
              />
            </div>
            <div class="mb-3">
              <Input
                @type="email"
                @value={{this.email}}
                data-display-name="email"
                data-test-input="email"
                id="email"
                class="form-control"
                name="email"
                placeholder="Your email"
              />
            </div>
            <div class="mb-4">
              <Textarea
                @value={{this.message}}
                data-display-name="message"
                data-test-input="message"
                id="message"
                rows="5"
                class="form-control"
                name="message"
                placeholder="Your message"
              />
            </div>
            <div>
              {{#if this.sending}}
                <button class="d-block w-100 btn btn-primary hidden" type="button" disabled>
                  <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                  Sending...
                </button>
              {{else}}
                <button
                  disabled={{if this.isFormValid false true}}
                  type="button"
                  class="btn btn-primary d-block w-100"
                  data-test-action="submit-form"
                  {{on "click" this.submitForm}}
                >
                  {{#if this.isFormValid}}
                    Send message
                  {{else}}
                    Please fill out all fields
                  {{/if}}
                </button>
              {{/if}}
              <div>
                <button
                  disabled={{this.cannotSubmit}}
                  type="submit"
                  class="btn btn-primary d-block w-100"
                >
                  {{if this.sending "Sending…" "Send"}}
                </button>
              </div>
            </form>
          {{/if}}
        </div>
      </div>
    </div>
  </div>
</section>
